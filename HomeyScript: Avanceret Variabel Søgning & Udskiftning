/**
 * =========================================================================
 * HomeyScript: Avanceret Variabel Søgning & Udskiftning (Find & Replace)
 * =========================================================================
 * Dette script giver dig fuldt overblik over variabler og tags i din Homey.
 * 
 * Nøglefunktioner:
 * - SØG ('SEARCH'): Scanner alle Standard Flows, Advanced Flows, HomeyScripts,
 *   Logic Variabler og Tokens for at finde præcis hvor et navn bruges.
 * - UDSKIFT ('REPLACE'): Omdøber variablen på tværs af hele systemet.
 * - DRY RUN: Sikkerhedsmekanisme der lader dig simulere en udskiftning først, 
 *   så du præcist kan se hvad der vil blive ændret uden at gemme noget.
 * - SIKKERHED: Indbygget beskyttelse mod specialtegn og system-reserverede 
 *   ord, så du ikke kan komme til at korrumpere dine flows.
 * =========================================================================
 */

const ACTION = 'SEARCH'; // Vælg 'SEARCH' (kun visning af hvor variablen bruges) eller 'REPLACE' (udskift variablen)
const variableToFind = 'nat lys'; 
const newVariableName = 'nyt lys'; // Det nye variabelnavn (kun relevant hvis ACTION = 'REPLACE')
const dryRun = true; // Sæt til false for at udføre faktiske ændringer ved 'REPLACE'!

// Timeout for API-kald i millisekunder
const API_TIMEOUT_MS = 15000;

// Funktion til at indkapsle asynkrone API-kald med en timeout for at forhindre script-hang
function withTimeout(promise, ms, name) {
    if (typeof setTimeout === 'function' && typeof clearTimeout === 'function') {
        return new Promise((resolve, reject) => {
            const timer = setTimeout(() => {
                console.error(`⏳ TIMEOUT: API-kald '${name}' timede ud efter ${ms}ms.`);
                reject(new Error(`Timeout: ${name}`));
            }, ms);
            promise.then(res => { clearTimeout(timer); resolve(res); })
                   .catch(err => { clearTimeout(timer); reject(err); });
        });
    } else if (typeof wait === 'function') {
        let isResolved = false;
        const wrappedPromise = promise.then(
            res => { isResolved = true; return res; },
            err => { isResolved = true; throw err; }
        );
        const timeoutPromise = wait(ms).then(() => {
            if (!isResolved) {
                console.error(`⏳ TIMEOUT: API-kald '${name}' timede ud efter ${ms}ms.`);
                throw new Error(`Timeout: ${name}`);
            }
        });
        return Promise.race([wrappedPromise, timeoutPromise]);
    }
    return promise;
}

// Hjælpefunktion til at "escape" specialtegn i tekst, så de ikke ødelægger vores RegExp
function escapeRegExp(string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); // $& betyder hele det matchede tegn
}

// Hjælpefunktion til dyb søgning og sikker udskiftning af string-værdier (beskytter JSON-nøgler)
function deepSearchAndReplace(obj, searchRegex, replaceRegex, replacementStr, performReplace) {
    let hasMatch = false;

    // Nøgler vi ALDRIG må ændre indholdet af, da de udgør flowets metadata og fundamentale struktur
    const protectedKeys = [
        'id', 'uri', 'ownerUri', 'type', 'token', 'droptokens', 'folder',
        'name', 'title', 'titleFormatted', 'description', 'createdAt',
        'modifiedAt', 'icon', 'color', 'metadata', 'version'
    ];

    function traverse(item, keyName = null) {
        // Afbryd søgningen tidligt, hvis vi rammer en beskyttet nøgle (undgår falske positive i hele grene)
        if (protectedKeys.includes(keyName)) {
            return item;
        }

        if (typeof item === 'string') {
            if (searchRegex.test(item)) {
                hasMatch = true;
                if (performReplace) {
                    return item.replace(replaceRegex, replacementStr);
                }
            }
            return item;
        } else if (Array.isArray(item)) {
            if (performReplace) {
                return item.map(el => traverse(el, keyName)); // Sender keyName videre ned
            } else {
                item.forEach(el => traverse(el, keyName));
                return item;
            }
        } else if (item !== null && typeof item === 'object') {
            if (performReplace) {
                const newObj = {};
                for (const key in item) {
                    // KUN værdier opdateres, nøgler (keys) holdes intakte!
                    newObj[key] = traverse(item[key], key); // Giver den aktuelle nøgle (key) med
                }
                return newObj;
            } else {
                for (const key in item) {
                    traverse(item[key], key);
                }
                return item;
            }
        }
        return item;
    }

    const resultObj = traverse(obj);
    return { hasMatch, resultObj };
}

async function findVariableUsage() {
    // 1. Validering af input før vi overhovedet starter
    if (typeof variableToFind !== 'string' || variableToFind.trim() === '') {
        console.error('❌ Afbrudt: "variableToFind" er tom. Angiv venligst, hvad der skal søges efter.');
        return false;
    }

    // Sikkerhedsliste mod at ødelægge Homeys JSON-struktur ved REPLACE
    const reservedWords = ['id', 'name', 'type', 'uri', 'args', 'token', 'droptokens', 'folder', 'true', 'false', 'null', 'undefined'];
    if (ACTION === 'REPLACE' && reservedWords.includes(variableToFind.toLowerCase())) {
        console.error(`❌ Afbrudt: Du forsøger at udskifte et system-reserveret ord ("${variableToFind}"). Dette vil korrumpere dine flows!`);
        return false;
    }

    // Valider kun det nye navn, hvis vi reelt ønsker at udskifte (REPLACE)
    if (ACTION === 'REPLACE') {
        if (typeof newVariableName !== 'string' || newVariableName.trim() === '') {
            console.error('❌ Afbrudt: "newVariableName" er tom eller ugyldig. Udfyld venligst et gyldigt nyt navn.');
            return false;
        }
        if (newVariableName.includes('"') || newVariableName.includes('\\')) {
            console.error('❌ Afbrudt: "newVariableName" indeholder ulovlige tegn (" eller \\). Dette vil ødelægge Homeys JSON-struktur!');
            return false;
        }
    }

    // Hent alt data parallelt og sikkert (fanger evt. fejl, hvis et API ikke er tilgængeligt)
    const [allFlows, allAdvancedFlows, allFolders, allScripts, allLogicVars, allTokens] = await Promise.all([
        withTimeout(Homey.flow.getFlows(), API_TIMEOUT_MS, 'getFlows').catch(() => ({})),
        withTimeout(Homey.flow.getAdvancedFlows(), API_TIMEOUT_MS, 'getAdvancedFlows').catch(() => ({})),
        (typeof Homey.flow.getFolders === 'function') ? withTimeout(Homey.flow.getFolders(), API_TIMEOUT_MS, 'getFolders').catch(() => ({})) : Promise.resolve({}),
        (Homey.script && typeof Homey.script.getScripts === 'function') ? withTimeout(Homey.script.getScripts(), API_TIMEOUT_MS, 'getScripts').catch(() => ({})) : Promise.resolve({}),
        (Homey.logic && typeof Homey.logic.getVariables === 'function') ? withTimeout(Homey.logic.getVariables(), API_TIMEOUT_MS, 'getVariables').catch(() => ({})) : Promise.resolve({}),
        (Homey.flow && typeof Homey.flow.getTokens === 'function') ? withTimeout(Homey.flow.getTokens(), API_TIMEOUT_MS, 'getTokens').catch(() => ({})) : Promise.resolve({})
    ]);

    let findings = [];
    
    const escapedVariable = escapeRegExp(variableToFind);
    
    // Lookbehinds/Lookaheads bruges i stedet for \b, da det også understøtter specialtegn som parenteser i starten/slutningen af navnet
    const searchRegex = new RegExp('(?<!\\w)' + escapedVariable + '(?!\\w)', 'i');
    const replaceRegex = new RegExp('(?<!\\w)' + escapedVariable + '(?!\\w)', 'gi');

    console.log(`🔍 Starter i [${ACTION}] tilstand for variablen: "${variableToFind}"...\n`);

    // Hjælpefunktion til at forhindre at Homey overbelastes ved mange opdateringer (throttling)
    async function throttleUpdate() {
        if (typeof wait === 'function') {
            await wait(50);
        } else {
            await new Promise(resolve => setTimeout(resolve, 50));
        }
    }

    // Gennemgå standard flows
    for (const flow of Object.values(allFlows)) {
        const { hasMatch, resultObj: parsedFlow } = deepSearchAndReplace(flow, searchRegex, replaceRegex, newVariableName, ACTION === 'REPLACE');
        
        if (hasMatch) {
            const folderName = flow.folder ? (allFolders[flow.folder]?.name ?? `ID: ${flow.folder}`) : 'Ingen mappe';
            findings.push({ Type: 'Standard Flow', Navn: flow.name, Mappe: folderName });

            if (ACTION === 'REPLACE') {
                if (dryRun) {
                    console.log(`   -> 🧪 [DRY RUN] Ville auto-opdatere flow: "${flow.name}"`);
                } else {
                    try {
                        await Homey.flow.updateFlow({ id: flow.id, flow: parsedFlow });
                        console.log(`   -> 🔄 Auto-opdaterede flow: "${flow.name}"`);
                        await throttleUpdate();
                    } catch (err) {
                        console.error(`   -> ❌ Fejl ved opdatering (JSON/API) for flow "${flow.name}": ${err.message}`);
                    }
                }
            }
        }
    }

    // Gennemgå Advanced Flows
    for (const advFlow of Object.values(allAdvancedFlows)) {
        const { hasMatch, resultObj: parsedAdvFlow } = deepSearchAndReplace(advFlow, searchRegex, replaceRegex, newVariableName, ACTION === 'REPLACE');
        
        if (hasMatch) {
            const folderName = advFlow.folder ? (allFolders[advFlow.folder]?.name ?? `ID: ${advFlow.folder}`) : 'Ingen mappe';
            findings.push({ Type: 'Advanced Flow', Navn: advFlow.name, Mappe: folderName });

            if (ACTION === 'REPLACE') {
                if (dryRun) {
                    console.log(`   -> 🧪 [DRY RUN] Ville auto-opdatere advanced flow: "${advFlow.name}"`);
                } else {
                    try {
                        await Homey.flow.updateAdvancedFlow({ id: advFlow.id, advancedFlow: parsedAdvFlow });
                        console.log(`   -> 🔄 Auto-opdaterede advanced flow: "${advFlow.name}"`);
                        await throttleUpdate();
                    } catch (err) {
                        console.error(`   -> ❌ Fejl ved opdatering (JSON/API) for advanced flow "${advFlow.name}": ${err.message}`);
                    }
                }
            }
        }
    }

    // Gennemgå HomeyScripts
    for (const script of Object.values(allScripts)) {
        if (script.code && searchRegex.test(script.code)) {
            findings.push({ Type: 'HomeyScript', Navn: script.name, Mappe: 'Scripts' });

            if (ACTION === 'REPLACE') {
                const updatedCode = script.code.replace(replaceRegex, newVariableName);
                if (dryRun) {
                    console.log(`   -> 🧪 [DRY RUN] Ville auto-opdatere HomeyScript: "${script.name}"`);
                } else {
                    try {
                        // Vi kopierer det eksisterende script-objekt og overskriver kun koden
                        const updatedScriptObj = { ...script, code: updatedCode };
                        await Homey.script.updateScript({ id: script.id, script: updatedScriptObj });
                        console.log(`   -> 🔄 Auto-opdaterede HomeyScript: "${script.name}"`);
                        await throttleUpdate();
                    } catch (err) {
                        console.error(`   -> ❌ Fejl ved opdatering af HomeyScript: ${err.message}`);
                    }
                }
            }
        }
    }

    // Gennemgå Homey Logic Variabler
    for (const logicVar of Object.values(allLogicVars)) {
        // For variabler tjekker vi det præcise navn (ignorerer dog store/små bogstaver)
        if (logicVar.name.toLowerCase() === variableToFind.toLowerCase()) {
            findings.push({ Type: 'Logic Variabel', Navn: logicVar.name, Mappe: 'Homey Logic' });

            if (ACTION === 'REPLACE') {
                if (dryRun) {
                    console.log(`   -> 🧪 [DRY RUN] Ville auto-omdøbe Logic variabel: "${logicVar.name}" til "${newVariableName}"`);
                } else {
                    try {
                        await Homey.logic.updateVariable({ id: logicVar.id, variable: { name: newVariableName } });
                        console.log(`   -> 🔄 Auto-omdøbte Logic variabel: "${logicVar.name}" til "${newVariableName}"`);
                        await throttleUpdate();
                    } catch (err) {
                        console.error(`   -> ❌ Fejl ved omdøbning af Logic variabel: ${err.message}`);
                    }
                }
            }
        }
    }

    // Gennemgå Indbyggede Tags (Tokens)
    for (const token of Object.values(allTokens)) {
        const tokenName = token.title || token.name || '';
        if (tokenName.toLowerCase() === variableToFind.toLowerCase()) {
            // Spring over Logic variabler, da vi allerede har dækket dem ovenfor
            if (token.uri && token.uri.includes('homey:manager:logic')) continue;
            
            findings.push({ Type: 'Indbygget Tag', Navn: tokenName, Mappe: token.uri || 'System' });

            if (ACTION === 'REPLACE') {
                console.log(`   -> ⚠️ [ADVARSEL] Tagget "${tokenName}" er et system-tag (URI: ${token.uri}). Scriptet opdaterer dine flows, men selve kilde-tagget kan ikke omdøbes automatisk.`);
            }
        }
    }

    // Præsentation af resultater
    if (findings.length > 0) {
        console.log(`✅ Fundet ${findings.length} steder:`);
        
        // Gruppér resultaterne efter type
        const groupedFindings = findings.reduce((acc, curr) => {
            if (!acc[curr.Type]) acc[curr.Type] = [];
            acc[curr.Type].push(curr);
            return acc;
        }, {});

        // Udskriv grupperet
        for (const [type, items] of Object.entries(groupedFindings)) {
            console.log(`\n📌 ${type} (${items.length}):`);
            
            // Sorter items alfabetisk efter mappenavn, og derefter efter navn hvis mappen er ens
            items.sort((a, b) => a.Mappe.localeCompare(b.Mappe) || a.Navn.localeCompare(b.Navn));
            
            items.forEach(f => {
                console.log(`   - Navn: "${f.Navn}" | Mappe: "${f.Mappe}"`);
            });
        }
        
        if (ACTION === 'REPLACE' && dryRun) {
            console.log('\n⚠️ Dette var en Dry Run test (intet er ændret). Sæt "const dryRun = false;" for at gemme ændringerne!');
        } else if (ACTION === 'SEARCH') {
            console.log('\n🔎 Søgning fuldført. Ingen ændringer foretaget (ACTION er sat til SEARCH).');
        }
    } else {
        console.log('❌ Variablen blev ikke fundet i nogen flows.');
    }
    
    try {
        await tag('Antal_Variabler_Fundet', findings.length);
    } catch (err) {
        console.error(`⚠️ Kunne ikke opdatere system-tag 'Antal_Variabler_Fundet': ${err.message}`);
    }

    return findings.length > 0;
}

await findVariableUsage();
